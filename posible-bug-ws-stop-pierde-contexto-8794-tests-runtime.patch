+        fixture.wait_for_turn_to_settle(&session_key).await;
+        drop(client);
+        fixture.shutdown();
+    }
+
+    /// T11. Prediction: RED on master (H6, unconfirmed). A real SQLite trigger
+    /// makes the post-cancel transcript replacement fail. The cancelled branch
+    /// ignores the failure and advances the watermark, so the next turn on the
+    /// same connection may rebuild its history from the stale store and lose
