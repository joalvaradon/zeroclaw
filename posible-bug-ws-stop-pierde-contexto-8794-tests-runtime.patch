+// ── Issue 8794: interrupted turns must keep their completed tool rounds ──
+//
+// Fixtures use neutral, synthetic markers (`zeroclaw_fixture_marker`).
+// Predictions are written next to each assertion before the first run.
+
+fn debug_contains(messages: &[ConversationMessage], needle: &str) -> bool {
+    messages.iter().any(|m| format!("{m:?}").contains(needle))
+}
+
+fn interruption_marker() -> String {
+    crate::i18n::get_english_cli_string_with_args("turn-interrupted-by-user", &[])
+}
+
+/// Tool that cancels the turn after it has produced its output.
+struct CancelAfterOutputTool {
+    name: &'static str,
+    token: tokio_util::sync::CancellationToken,
+}
+zeroclaw_api::tool_attribution!(
+    CancelAfterOutputTool,
+    ::zeroclaw_api::attribution::ToolKind::Plugin
+);
+#[async_trait]
+impl Tool for CancelAfterOutputTool {
+    fn name(&self) -> &str {
+        self.name
+    }
+    fn description(&self) -> &str {
+        self.name
+    }
+    fn parameters_schema(&self) -> serde_json::Value {
+        serde_json::json!({"type": "object"})
+    }
+    async fn execute(&self, _args: serde_json::Value) -> Result<crate::tools::ToolResult> {
+        self.token.cancel();
+        Ok(crate::tools::ToolResult {
+            success: true,
+            output: "zeroclaw_fixture_marker".to_string().into(),
+            error: None,
+        })
+    }
+}
+
+/// T2 control. Prediction: PASSES on master (the mid-batch cancel appends the
+/// round, tool slot 1 keeps its real output, slot 2 gets the interrupted text).
+#[tokio::test]
+async fn issue_8794_t2_midbatch_cancel_keeps_round_in_new_messages() {
+    let token = tokio_util::sync::CancellationToken::new();
+    let later_calls = Arc::new(AtomicUsize::new(0));
+    let mut agent = build_agent(
+        Box::new(ScriptedProvider::new(vec![tool_response(vec![
+            tool_call("t2a", "gamma"),
+            tool_call("t2b", "alpha"),
+        ])])),
+        vec![
+            Box::new(CancelAfterOutputTool {
+                name: "gamma",
+                token: token.clone(),
+            }),
+            Box::new(CountingTool {
+                name: "alpha",
+                calls: Arc::clone(&later_calls),
+            }),
+        ],
+    );
+    let (tx, mut rx) = mpsc::channel(256);
+    let handle = zeroclaw_spawn::spawn!(async move {
+        agent
+            .turn_streamed_with_steering_state("t2", tx, Some(token), None)
+            .await
+    });
+    while rx.recv().await.is_some() {}
+    let err = handle.await.expect("task join").expect_err("cancelled");
+    assert_eq!(later_calls.load(Ordering::SeqCst), 0, "alpha must not run");
+    assert!(
+        err.new_messages
+            .iter()
+            .any(|m| matches!(m, ConversationMessage::AssistantToolCalls { .. })),
+        "the cancelled round's tool-call message must be recorded"
+    );
+    assert!(
+        debug_contains(&err.new_messages, "zeroclaw_fixture_marker"),
+        "the completed tool keeps its real output"
+    );
+}
+
+/// T7. Prediction: PASSES on master. Cancel lands after the only tool of
+/// round 1 finished, so the next iteration exits at its cancellation check:
+/// round 1 stays, and exactly one interruption marker is appended.
+#[tokio::test]
+async fn issue_8794_t7_cancel_between_rounds_keeps_prior_round_single_marker() {
+    let token = tokio_util::sync::CancellationToken::new();
+    let mut agent = build_agent(
+        Box::new(ScriptedProvider::new(vec![tool_response(vec![tool_call(
+            "t7a", "gamma",
+        )])])),
+        vec![Box::new(CancelAfterOutputTool {
+            name: "gamma",
+            token: token.clone(),
+        })],
+    );
+    let (tx, mut rx) = mpsc::channel(256);
+    let handle = zeroclaw_spawn::spawn!(async move {
+        agent
+            .turn_streamed_with_steering_state("t7", tx, Some(token), None)
+            .await
+    });
+    while rx.recv().await.is_some() {}
+    let err = handle.await.expect("task join").expect_err("cancelled");
+    assert!(
+        err.new_messages
+            .iter()
+            .any(|m| matches!(m, ConversationMessage::AssistantToolCalls { .. })),
+        "round 1 tool-call message must be kept"
+    );
+    assert!(debug_contains(&err.new_messages, "zeroclaw_fixture_marker"));
+    let marker = interruption_marker();
+    let markers = err
+        .new_messages
+        .iter()
+        .filter(|m| matches!(m, ConversationMessage::Chat(c) if c.role == "assistant" && c.content.contains(&marker)))
+        .count();
+    assert_eq!(markers, 1, "exactly one interruption marker");
+}
+
+/// T5. Prediction: PASSES on master and pins E11. A stream that produced only
+/// transient thinking persists only the bare marker; the thinking text is not
+/// in `new_messages`.
+#[tokio::test]
+async fn issue_8794_t5_thinking_only_cancel_persists_only_marker() {
+    let provider = StreamThenHangProvider {
+        events: parking_lot::Mutex::new(vec![Ok(
+            zeroclaw_api::model_provider::StreamEvent::ThinkingDelta(
+                "zeroclaw_fixture_thinking".into(),
+            ),
+        )]),
+    };
+    let mut agent = build_agent(Box::new(provider), vec![]);
+    let token = tokio_util::sync::CancellationToken::new();
+    let cancel = token.clone();
+    let (tx, mut rx) = mpsc::channel(256);
+    let handle = zeroclaw_spawn::spawn!(async move {
+        agent
+            .turn_streamed_with_steering_state("t5", tx, Some(token), None)
+            .await
+    });
+    while let Some(ev) = rx.recv().await {
+        if matches!(&ev, TurnEvent::Thinking { .. }) {
+            cancel.cancel();
+            break;
+        }
+    }
+    while rx.recv().await.is_some() {}
+    let err = handle.await.expect("task join").expect_err("cancelled");
+    assert!(!debug_contains(&err.new_messages, "zeroclaw_fixture_thinking"));
+    let marker = interruption_marker();
+    let assistants: Vec<_> = err
+        .new_messages
+        .iter()
+        .filter_map(|m| match m {
+            ConversationMessage::Chat(c) if c.role == "assistant" => Some(c.content.clone()),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(assistants, vec![marker], "single bare marker");
+}
+
+/// T6 characterization of the gap. Prediction: PASSES on master, i.e. a tool
+/// call streamed before the cancel is NOT recorded (no AssistantToolCalls and
+/// no execution). This pins current behavior; whether it should change is a
+/// maintainer decision (plan, step 2).
+#[tokio::test]
+async fn issue_8794_t6_streamed_tool_call_before_cancel_is_not_recorded() {
+    let provider = StreamThenHangProvider {
+        events: parking_lot::Mutex::new(vec![Ok(
+            zeroclaw_api::model_provider::StreamEvent::ToolCall(tool_call_args(
+                "t6a",
+                "alpha",
+                serde_json::json!({}),
+            )),
+        )]),
+    };
+    let calls = Arc::new(AtomicUsize::new(0));
+    let mut agent = build_agent(
+        Box::new(provider),
+        vec![Box::new(CountingTool {
+            name: "alpha",
+            calls: Arc::clone(&calls),
+        })],
+    );
+    let token = tokio_util::sync::CancellationToken::new();
+    let cancel = token.clone();
+    let (tx, mut rx) = mpsc::channel(256);
+    let handle = zeroclaw_spawn::spawn!(async move {
+        agent
+            .turn_streamed_with_steering_state("t6", tx, Some(token), None)
+            .await
+    });
+    tokio::time::sleep(std::time::Duration::from_millis(300)).await;
+    cancel.cancel();
+    while rx.recv().await.is_some() {}
+    let err = handle.await.expect("task join").expect_err("cancelled");
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert!(
+        !err.new_messages
+            .iter()
+            .any(|m| matches!(m, ConversationMessage::AssistantToolCalls { .. })),
+        "streamed-but-unexecuted tool call is not recorded today"
+    );
+}
