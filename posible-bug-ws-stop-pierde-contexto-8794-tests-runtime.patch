+    }
+
+    async fn issue_8794_t12_inner() {
+        let mut fixture = issue_8794_fixture().await;
+        let session_id = "issue-8794-t12";
+        let session_key = format!("{GW_SESSION_PREFIX}{session_id}");
+        let (mut client, _) = fixture.connect(session_id).await;
+        issue_8794_park_after_tool_round(&mut fixture, &mut client).await;
+
+        issue_8794_abort(&fixture, session_id).await;
+        send_chat(&mut client, "zeroclaw_fixture_followup sent right after stop").await;
+        let arrived = tokio::time::timeout(Duration::from_secs(5), fixture.request_seen.recv())
+            .await;
+        let carried = matches!(
+            &arrived,
+            Ok(Some(request)) if request.to_string().contains("zeroclaw_fixture_followup")
+        );
+        assert!(
+            carried,
+            "the message sent right after Stop must reach the provider: {arrived:?}"
+        );
+        fixture.release_next();
+        fixture.release_next();
+        fixture.wait_for_turn_to_settle(&session_key).await;
+        drop(client);
+        fixture.shutdown();
+    }
 }
