+        assert!(
+            third.contains(ISSUE_8794_MARKER),
+            "the interrupted turn's tool result must survive a reconnect"
+        );
+        fixture.release_next();
+        fixture.release_next();
+        fixture.wait_for_turn_to_settle(&session_key).await;
+        drop(client);
+        fixture.shutdown();
+    }
+
+    /// T10. Prediction: RED on master (native tools). The client aborts and
+    /// drops the socket at once (as on a model or session switch), without
