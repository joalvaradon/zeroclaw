+        );
+        fixture.release_next();
+        fixture.release_next();
+        fixture.wait_for_turn_to_settle(&session_key).await;
+        drop(client);
+        fixture.shutdown();
+    }
+
+    /// T4. Prediction: RED on master (native tools). After a reconnect the
