+/// Tool-round shapes for the durable projection used by the WebSocket store.
+/// Runs a turn whose single tool round finishes and cancels, then returns
+/// what `durable_chat_messages` keeps from the agent's history.
+async fn issue_8794_durable_after_cancelled_round(
+    prompt_guided: bool,
+) -> Vec<zeroclaw_providers::ChatMessage> {
+    let token = tokio_util::sync::CancellationToken::new();
+    let workspace = test_workspace();
+    let response = if prompt_guided {
+        text_response("<tool_call>{\"name\":\"gamma\",\"arguments\":{}}</tool_call>")
+    } else {
+        tool_response(vec![tool_call("t9a", "gamma")])
+    };
+    let dispatcher: Box<dyn ToolDispatcher> = if prompt_guided {
+        Box::new(XmlToolDispatcher)
+    } else {
+        Box::new(NativeToolDispatcher)
+    };
+    let mut agent = Agent::builder()
+        .model_provider(Box::new(ScriptedProvider::new(vec![response])))
+        .tools(crate::tools::scoped::ScopedToolRegistry::from_raw_for_test(
+            vec![Box::new(CancelAfterOutputTool {
+                name: "gamma",
+                token: token.clone(),
+            }) as Box<dyn Tool>],
+        ))
+        .memory(mem_none(workspace.path()))
+        .observer(Arc::from(observability::NoopObserver {}))
+        .tool_dispatcher(dispatcher)
+        .workspace_dir(workspace.path().to_path_buf())
+        .build()
+        .expect("agent builder should succeed");
+    let (tx, mut rx) = mpsc::channel(256);
+    let outcome = agent
+        .turn_streamed_with_steering_state("t9", tx, Some(token), None)
+        .await;
+    while rx.recv().await.is_some() {}
+    outcome.expect_err("cancelled");
+    zeroclaw_providers::durable_chat_messages(agent.history())
+}
